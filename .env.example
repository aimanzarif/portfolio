# Copy to .env on the server and fill in. docker compose reads it automatically.

# Live status (Uptime Kuma on the same Docker network)
UPTIME_KUMA_URL=http://uptime-kuma:3001

# Laptop vitals for voyager (Netdata installed on the host)
NETDATA_URL=http://host.docker.internal:19999

# Cloudflare Web Analytics
CF_BEACON_TOKEN=

# Guestbook: Cloudflare Turnstile keys (dash.cloudflare.com > Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Long random string for scripts/guestbook.sh, e.g. `openssl rand -hex 24`
GUESTBOOK_ADMIN_TOKEN=
# Secret salt for hashing visitor IPs in the guestbook rate limit: openssl rand -hex 24
GUESTBOOK_SALT=

# Phone number shown only after a Turnstile check (never in the page or the repo), e.g. +60 11-1234 5678
CONTACT_PHONE=

# Radio + playlist (Spotify). Create an app at developer.spotify.com (Redirect URI http://127.0.0.1:8888/callback),
# then get the refresh token once with: SPOTIFY_CLIENT_ID=.. SPOTIFY_CLIENT_SECRET=.. node scripts/spotify-auth.mjs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# The id from your playlist's share link: open.spotify.com/playlist/<THIS PART>?si=...
SPOTIFY_PLAYLIST_ID=
# Optional: "now playing" is shown this many minutes late (0 = live), and not at all during
# these Klang-time hours ("0-7" = midnight to 7am, "22-6" wraps, "off" = never quiet).
MUSIC_DELAY_MINUTES=15
MUSIC_QUIET_HOURS=0-7
